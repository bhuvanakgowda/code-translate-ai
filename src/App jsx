const FEATURES = [
  {
    id: "translate",
    icon: "⟶",
    title: "Code Translation",
    desc: "Convert code between programming languages instantly"
  },
  {
    id: "complexity",
    icon: "◈",
    title: "Complexity Analysis",
    desc: "Big-O time & space complexity breakdown"
  },
  {
    id: "optimize",
    icon: "⬡",
    title: "Optimization",
    desc: "Suggestions to improve performance"
  },
  {
    id: "explain",
    icon: "◎",
    title: "Code Explanation",
    desc: "Understand code in plain English"
  }
];

const SAMPLE_CODE = {
  Python: `def binary_search(arr, target):
    left, right = 0, len(arr) - 1
    while left <= right:
        mid = (left + right) // 2
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    return -1`,

  JavaScript: `function binarySearch(arr, target) {
  let left = 0, right = arr.length - 1;

  while (left <= right) {
    const mid = Math.floor((left + right) / 2);

    if (arr[mid] === target) return mid;
    else if (arr[mid] < target) left = mid + 1;
    else right = mid - 1;
  }

  return -1;
}`,

  Java: `public int binarySearch(int[] arr, int target) {
    int left = 0;
    int right = arr.length - 1;

    while (left <= right) {
        int mid = left + (right - left) / 2;

        if (arr[mid] == target) return mid;
        else if (arr[mid] < target) left = mid + 1;
        else right = mid - 1;
    }

    return -1;
}`
};

function generateResult(feature, source, from, to) {
  if (!source.trim()) {
    return "Enter some code first.";
  }

  if (feature === "translate") {
    if (from === "Python" && to === "JavaScript") {
      return SAMPLE_CODE.JavaScript;
    }

    if (from === "JavaScript" && to === "Python") {
      return SAMPLE_CODE.Python;
    }

    if (to === "Java") {
      return SAMPLE_CODE.Java;
    }

    return `// ${to} version

// Translation preview
// Source: ${from}
// Target: ${to}

${source}`;
  }

  if (feature === "complexity") {
    return `TIME COMPLEXITY
O(log n)

SPACE COMPLEXITY
O(1)

ANALYSIS
The algorithm repeatedly divides the
search space approximately in half.
Therefore the number of iterations
grows logarithmically with input size.`;
  }

  if (feature === "optimize") {
    return `OPTIMIZATION SUGGESTIONS

1. Avoid unnecessary calculations.
2. Keep loop operations minimal.
3. Use efficient data structures.
4. For binary search, calculate the
   midpoint using:

left + (right - left) / 2

This can prevent integer overflow
in fixed-size integer languages.`;
  }

  return `CODE EXPLANATION

The code processes the input according
to its control flow.

Key points:
• Input is processed sequentially.
• Conditions control execution.
• Variables are updated during execution.
• The final result is returned.

For full AI-powered explanations,
connect the application to an LLM API.`;
}

function AuthScreen({ onAuth }) {
  const [mode, setMode] = useState("login");
  const [form, setForm] = useState({
    name: "",
    email: "",
    password: ""
  });
  const [error, setError] = useState("");

  const handleSubmit = (e) => {
    e.preventDefault();
    setError("");

    if (!form.email || !form.password) {
      setError("Email and password are required.");
      return;
    }

    if (mode === "register" && !form.name.trim()) {
      setError("Name is required.");
      return;
    }

    const users = JSON.parse(
      localStorage.getItem("codetranslate_users") || "{}"
    );

    if (mode === "register") {
      if (users[form.email]) {
        setError("Email already registered.");
        return;
      }

      users[form.email] = {
        name: form.name,
        email: form.email,
        password: form.password
      };

      localStorage.setItem(
        "codetranslate_users",
        JSON.stringify(users)
      );

      onAuth(users[form.email]);
    } else {
      const user = users[form.email];

      if (!user || user.password !== form.password) {
        setError("Invalid email or password.");
        return;
      }

      onAuth(user);
    }
  };

  const googleLogin = () => {
    onAuth({
      name: "Google User",
      email: "google@demo.com"
    });
  };

  return (
    <div className="auth-wrap">
      <form className="auth-card" onSubmit={handleSubmit}>
        <div className="auth-logo">
          <span className="logo-dot" />
          CodeTranslate
        </div>

        <h1 className="auth-title">
          {mode === "login" ? "Welcome back" : "Create account"}
        </h1>

        <p className="auth-sub">
          {mode === "login"
            ? "Sign in to access your AI translator"
            : "Start translating code across languages"}
        </p>

        {error && (
          <div className="auth-error">
            ⚠ {error}
          </div>
        )}

        {mode === "register" && (
          <div className="field">
            <label>Full name</label>
            <input
              value={form.name}
              placeholder="Your name"
              onChange={(e) =>
                setForm({ ...form, name: e.target.value })
              }
            />
          </div>
        )}

        <div className="field">
          <label>Email</label>
          <input
            type="email"
            value={form.email}
            placeholder="you@example.com"
            onChange={(e) =>
              setForm({ ...form, email: e.target.value })
            }
          />
        </div>

        <div className="field">
          <label>Password</label>
          <input
            type="password"
            value={form.password}
            placeholder="••••••••"
            onChange={(e) =>
              setForm({ ...form, password: e.target.value })
            }
          />
        </div>

        <button className="btn-primary" type="submit">
          {mode === "login" ? "Sign In" : "Create Account"}
        </button>

        <div className="divider">or</div>

        <button
          type="button"
          className="btn-google"
          onClick={googleLogin}
        >
          Continue with Google
        </button>

        <div className="auth-switch">
          {mode === "login"
            ? "Don't have an account? "
            : "Already have an account? "}

          <button
            type="button"
            onClick={() =>
              setMode(mode === "login" ? "register" : "login")
            }
          >
            {mode === "login" ? "Create one" : "Sign in"}
          </button>
        </div>
      </form>
    </div>
  );
}

function MainApp({ user, onLogout }) {
  const [activeTab, setActiveTab] = useState("translator");
  const [feature, setFeature] = useState("translate");
  const [from, setFrom] = useState("Python");
  const [to, setTo] = useState("JavaScript");
  const [code, setCode] = useState(SAMPLE_CODE.Python);
  const [result, setResult] = useState("");
  const [history, setHistory] = useState([]);

  useEffect(() => {
    try {
      const saved = JSON.parse(
        localStorage.getItem("codetranslate_history") || "[]"
      );
      setHistory(saved);
    } catch {
      setHistory([]);
    }
  }, []);

  const runFeature = () => {
    const output = generateResult(
      feature,
      code,
      from,
      to
    );

    setResult(output);

    const item = {
      id: Date.now(),
      feature,
      from,
      to,
      code: code.slice(0, 150),
      result: output,
      time: new Date().toLocaleString()
    };

    const updated = [item, ...history].slice(0, 20);

    setHistory(updated);

    localStorage.setItem(
      "codetranslate_history",
      JSON.stringify(updated)
    );
  };

  const copyResult = async () => {
    if (!result) return;

    try {
      await navigator.clipboard.writeText(result);
      alert("Copied!");
    } catch {
      alert("Copy failed.");
    }
  };

  const loadHistory = (item) => {
    setResult(item.result);
    setCode(item.code);
    setFrom(item.from);
    setTo(item.to);
    setFeature(item.feature);
    setActiveTab("translator");
  };

  return (
    <div className="app">
      <header className="topbar">
        <div className="topbar-logo">
          <span className="logo-dot" />
          CodeTranslate AI
        </div>

        <div className="topbar-right">
          <div className="user-badge">
            <span className="user-dot" />
            {user.name}
          </div>

          <button
            className="btn-logout"
            onClick={onLogout}
          >
            Logout
          </button>
        </div>
      </header>

      <nav className="tabs">
        <button
          className={`tab-btn ${
            activeTab === "translator" ? "active" : ""
          }`}
          onClick={() => setActiveTab("translator")}
        >
          Translator
        </button>

        <button
          className={`tab-btn ${
            activeTab === "history" ? "active" : ""
          }`}
          onClick={() => setActiveTab("history")}
        >
          History
        </button>
      </nav>

      <main className="main">
        {activeTab === "translator" ? (
          <>
            <div className="feature-bar">
              {FEATURES.map((item) => (
                <button
                  key={item.id}
                  className={`feat-card ${
                    feature === item.id ? "active" : ""
                  }`}
                  onClick={() => {
                    setFeature(item.id);
                    setResult("");
                  }}
                >
                  <div className="feat-icon">
                    {item.icon}
                  </div>

                  <div className="feat-title">
                    {item.title}
                  </div>

                  <div className="feat-desc">
                    {item.desc}
                  </div>
                </button>
              ))}
            </div>

            <div className="translator-grid">
              <section className="panel-card">
                <div className="panel-header">
                  <span className="panel-title">
                    Source Code
                  </span>

                  <select
                    className="lang-select"
                    value={from}
                    onChange={(e) => {
                      const value = e.target.value;
                      setFrom(value);

                      if (SAMPLE_CODE[value]) {
                        setCode(SAMPLE_CODE[value]);
                      }
                    }}
                  >
                    {LANGUAGES.map((lang) => (
                      <option key={lang} value={lang}>
                        {lang}
                      </option>
                    ))}
                  </select>
                </div>

                <textarea
                  className="code-area"
                  value={code}
                  onChange={(e) =>
                    setCode(e.target.value)
                  }
                  spellCheck="false"
                />
              </section>

              <div className="arrow-col">
                <button
                  className="translate-btn"
                  onClick={runFeature}
                  title="Run"
                >
                  →
                </button>
              </div>

              <section className="panel-card">
                <div className="panel-header">
                  <span className="panel-title">
                    Output
                  </span>

                  <select
                    className="lang-select"
                    value={to}
                    onChange={(e) =>
                      setTo(e.target.value)
                    }
                  >
                    {LANGUAGES.map((lang) => (
                      <option key={lang} value={lang}>
                        {lang}
                      </option>
                    ))}
                  </select>
                </div>

                <div className="code-output">
         
